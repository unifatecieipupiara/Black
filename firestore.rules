rules_version = '2';

// Regras de segurança do Firestore.
// Copie TODO este conteúdo para: Firebase → Firestore Database → Regras → Publicar.
// Só os e-mails listados abaixo conseguem ver, criar, editar ou excluir leads
// e ler a chave que abre os dados da campanha (config/acesso).

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ TROQUE pelos e-mails Google de quem pode acessar (em letras minúsculas).
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'agaleriacampos@gmail.com',
          'mf0931162@gmail.com'
        ];
    }

    function leadValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'telefone', 'status', 'obs', 'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'
        ])
        && d.telefone is string && d.telefone.size() > 0 && d.telefone.size() <= 40
        && d.status in ['contatar', 'andamento', 'sem_retorno', 'matriculado', 'perdido']
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 2000));
    }

    match /leads/{leadId} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && leadValido();
    }

    // Chave dos dados da campanha (cursos, valores, links e vouchers).
    match /config/{docId} {
      allow read, write: if autorizado();
    }
  }
}
