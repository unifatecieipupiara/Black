rules_version = '2';

// Regras de segurança do Firestore.
// Copie TODO este conteúdo para: Firebase → Firestore Database → Regras → Publicar.
// Só os e-mails listados abaixo conseguem ver, criar, editar ou excluir leads
// e ler a chave que abre os dados da campanha (config/acesso).

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ TROQUE pelos e-mails Google de quem pode acessar (em letras minúsculas).
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'agaleriacampos@gmail.com',
          'mf0931162@gmail.com'
        ];
    }

    function leadValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nome', 'telefone', 'status', 'obs', 'matriculas', 'matriculadoEm', 'matriculadoPor',
          'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'
        ])
        && d.telefone is string && d.telefone.size() > 0 && d.telefone.size() <= 40
        && d.status in ['contatar', 'andamento', 'sem_retorno', 'matriculado', 'perdido']
        && (!('nome' in d) || (d.nome is string && d.nome.size() <= 200))
        && (!('matriculas' in d) || (d.matriculas is int && d.matriculas >= 0 && d.matriculas <= 20))
        && (!('matriculadoPor' in d) || (d.matriculadoPor is string && d.matriculadoPor.size() <= 128))
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 2000));
    }

    // Perfil de cada usuário (nome exibido no painel e no placar de matrículas).
    match /perfis/{uid} {
      allow read: if autorizado();
      allow write: if autorizado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60;
    }

    match /leads/{leadId} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && leadValido();
    }

    // Chave dos dados da campanha (cursos, valores, links e vouchers).
    match /config/{docId} {
      allow read, write: if autorizado();
    }

    // Cobranças (Feirão da Negociação): SOMENTE a gestora.
    function gestora() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'agaleriacampos@gmail.com';
    }

    function cobrancaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'telefone', 'qtd', 'polo', 'tipo', 'etapa', 'obs', 'vencimentos', 'criadoEm', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
        && d.telefone is string && d.telefone.size() <= 40
        && d.qtd is int && d.qtd >= 0 && d.qtd <= 120
        && d.etapa in ['contatar', 'negociacao', 'aguardando', 'finalizado', 'cancelado']
        && (!('polo' in d) || d.polo in ['ipupiara', 'barra-do-mendes'])
        && (!('tipo' in d) || d.tipo in ['graduacao', 'pos'])
        && (!('vencimentos' in d) || (d.vencimentos is list && d.vencimentos.size() <= 240))
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 2000));
    }

    match /cobrancas/{alunoId} {
      allow read, delete: if gestora();
      allow create, update: if gestora() && cobrancaValida();
    }
  }
}
