rules_version = '2';

// Regras de segurança do Firestore.
// Copie TODO este conteúdo para: Firebase → Firestore Database → Regras → Publicar.
// Só os e-mails listados abaixo conseguem ver, criar, editar ou excluir leads.

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ TROQUE pelos e-mails Google de quem pode acessar (em letras minúsculas).
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'email-da-gestora@gmail.com',
          'email-da-colaboradora@gmail.com'
        ];
    }

    function leadValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nome', 'telefone', 'cursoId', 'cursoNome', 'ingresso', 'status', 'obs',
          'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'
        ])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
        && d.status in ['andamento', 'sem_retorno', 'matriculado', 'perdido'];
    }

    match /leads/{leadId} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && leadValido();
    }
  }
}
