rules_version = '2';

// Regras de segurança do Firestore.
// Copie TODO este conteúdo para: Firebase → Firestore Database → Regras → Publicar.
// Só os e-mails listados abaixo conseguem ver, criar, editar ou excluir leads
// e ler a chave que abre os dados da campanha (config/acesso).

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ TROQUE pelos e-mails Google de quem pode acessar (em letras minúsculas).
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'agaleriacampos@gmail.com',
          'mf0931162@gmail.com'
        ];
    }

    function leadValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nome', 'telefone', 'status', 'obs', 'matriculas', 'matriculadoEm', 'matriculadoPor',
          'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'
        ])
        && d.telefone is string && d.telefone.size() > 0 && d.telefone.size() <= 40
        && d.status in ['contatar', 'andamento', 'sem_retorno', 'matriculado', 'perdido']
        && (!('nome' in d) || (d.nome is string && d.nome.size() <= 200))
        && (!('matriculas' in d) || (d.matriculas is int && d.matriculas >= 0 && d.matriculas <= 20))
        && (!('matriculadoPor' in d) || (d.matriculadoPor is string && d.matriculadoPor.size() <= 128))
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 2000));
    }

    // Perfil de cada usuário (nome exibido no painel e no placar de matrículas).
    match /perfis/{uid} {
      allow read: if autorizado();
      allow write: if autorizado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60;
    }

    match /leads/{leadId} {
      allow read, delete: if autorizado();
      allow create, update: if autorizado() && leadValido();
    }

    // Chave dos dados da campanha (cursos, valores, links e vouchers).
    match /config/{docId} {
      allow read, write: if autorizado();
    }

    // Cobranças (Feirão da Negociação): SOMENTE a gestora.
    function gestora() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'agaleriacampos@gmail.com';
    }

    function cobrancaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'telefone', 'qtd', 'polo', 'tipo', 'etapa', 'obs', 'vencimentos', 'previsaoCancelamento', 'criadoEm', 'atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
        && d.telefone is string && d.telefone.size() <= 40
        && d.qtd is int && d.qtd >= 0 && d.qtd <= 120
        && d.etapa in ['contatar', 'bloqueado', 'negociacao', 'aguardando', 'finalizado', 'cancelado', 'deferido']
        && (!('polo' in d) || d.polo in ['ipupiara', 'barra-do-mendes'])
        && (!('tipo' in d) || d.tipo in ['graduacao', 'pos'])
        && (!('vencimentos' in d) || (d.vencimentos is list && d.vencimentos.size() <= 240))
        && (!('previsaoCancelamento' in d) || (d.previsaoCancelamento is string && d.previsaoCancelamento.size() <= 10))
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 2000));
    }

    match /cobrancas/{alunoId} {
      allow read, delete: if gestora();
      allow create, update: if gestora() && cobrancaValida();
    }

    // Depoimentos do site (unifatecie-ead, página inicial).
    // Qualquer visitante pode ENVIAR um depoimento: ele entra como "pendente".
    // O site só consegue LER os aprovados. Aprovar, editar, tirar do site e
    // excluir: só a equipe autorizada, pela página Depoimentos do painel.
    function textoOk(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Foto opcional: JPEG em base64, já reduzida no celular do aluno.
    function fotoOk(d) {
      return !('foto' in d)
        || (d.foto is string && d.foto.size() <= 300000
          && d.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }

    function depoimentoNovo() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'curso', 'polo', 'texto', 'foto', 'autorizacao', 'status', 'criadoEm'])
        && d.keys().hasAll(['nome', 'curso', 'polo', 'texto', 'autorizacao', 'status', 'criadoEm'])
        && d.status == 'pendente'
        && d.autorizacao == true
        && d.criadoEm == request.time
        && textoOk(d.nome, 2, 80)
        && textoOk(d.curso, 2, 120)
        && d.polo in ['ipupiara', 'barra-do-mendes']
        && textoOk(d.texto, 20, 1500)
        && fotoOk(d);
    }

    function depoimentoEditado() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'curso', 'polo', 'texto', 'foto', 'autorizacao', 'status', 'criadoEm', 'atualizadoEm', 'atualizadoPor'])
        && d.status in ['pendente', 'aprovado']
        && d.criadoEm == resource.data.criadoEm
        && d.autorizacao == resource.data.autorizacao
        && textoOk(d.nome, 1, 80)
        && textoOk(d.curso, 1, 120)
        && d.polo in ['ipupiara', 'barra-do-mendes']
        && textoOk(d.texto, 1, 1500)
        && fotoOk(d)
        && (!('atualizadoPor' in d) || textoOk(d.atualizadoPor, 0, 200));
    }

    match /depoimentos/{depoimentoId} {
      allow read: if resource.data.status == 'aprovado' || autorizado();
      allow create: if depoimentoNovo();
      allow update: if autorizado() && depoimentoEditado();
      allow delete: if autorizado();
    }
  }
}
